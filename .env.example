# Environment Configuration for ProductOrder Webserver
# Copy this file to .env and adjust values for your external database connection.

SPRING_DATASOURCE_URL=jdbc:sqlserver://your-external-db-host:1433;databaseName=Central
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=your_external_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SERVER_PORT=8080
